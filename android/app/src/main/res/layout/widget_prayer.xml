<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="110dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#2D2A22">
    <TextView android:id="@+id/widgetCity" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مدينتك" android:textColor="#E6C77A" android:textSize="12sp" android:gravity="right" />
    <TextView android:id="@+id/widgetPrayerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="الصلاة القادمة" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:gravity="right" />
    <TextView android:id="@+id/widgetPrayerTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="--:--" android:textColor="#F2D58F" android:textSize="24sp" android:textStyle="bold" android:gravity="right" />
</LinearLayout>
