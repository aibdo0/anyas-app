<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F4ED">

    <ImageView
        android:id="@+id/splashArtwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="أنياس"
        android:src="@drawable/splash_art"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/splashTint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <TextView
        android:id="@+id/splashQuote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="40dp"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:text="ألا بذكر الله تطمئن القلوب"
        android:textColor="#806034"
        android:textSize="15sp"
        android:textStyle="bold" />

</FrameLayout>
